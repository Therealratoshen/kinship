# .gitignore — Kinship

# Real deployment configs contain channel tokens, sponsor contacts, and attendee sources.
packs/**/pack.local.yaml
# The community's working file: their copy, their next event, and their MEMBERS. It holds member
# identifiers, so it is ignored exactly like the answers next to it.
packs/**/pack.local.plan.yaml
packs/**/*.local.yaml
*.env
*.env.local

# Anything with member data in it. The pilot writes logs, never exports of member messages.
pilots/**/raw/
pilots/**/*.csv
pilots/**/*.json
!pilots/**/package.json

# Audit dumps may contain member identifiers before they're scrubbed.
audit/
*.log

# The persisted log the reference host writes. It holds member identifiers and the draft copy a
# card carries — a community's own audit file, never a repository artefact.
logs/

# OS / editor
.DS_Store
node_modules/
dist/
